# ==============================================================================
#  MindScope 服务端环境变量模板
#
#  用法：
#      copy .env.example .env          （Windows）
#      cp   .env.example .env          （Linux/macOS）
#  然后按需填写下面的值。**不要**把填好的 .env 提交到仓库（已在 .gitignore 排除）。
#
#  优先级：真实环境变量 > .env 里的值 > 本文件中的默认值
#         （启动脚本 .bat 里 `set HOST=0.0.0.0` 的写法依然生效）
# ==============================================================================

# ------------------------------------------------------------------ 服务监听
# 默认仅本机可访问。要让手机 / 其它电脑访问，必须设为 0.0.0.0（或用「启动-局域网共享.bat」）
# HOST=0.0.0.0
# PORT=8000

# ------------------------------------------------------------------ JWT 鉴权
# ★ 必需项：留空 / 保留下面的占位符 / 少于 32 字符，服务会直接启动失败。
#   （config.py 的 _require_secret 会拦住，不再有"源码里写死一个默认密钥"的兜底）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# 令牌有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------ 视觉大模型 VLM（人脸情绪解读）
# 未配置时：分析与报告功能正常，仅缺少云端语义化解读文本（服务端静默跳过，不报错）
VLM_API_KEY=
VLM_API_HOST=cloud.infini-ai.com
VLM_API_PATH=/maas/v1/chat/completions
VLM_MODEL=glm-4.6v

# ------------------------------------------------------------------ 文本大模型 LLM（报告生成）
# 留空则自动复用上面的 VLM_API_KEY
LLM_API_KEY=
LLM_API_HOST=cloud.infini-ai.com
LLM_API_PATH=/maas/v1/messages
LLM_MODEL=deepseek-v4-flash

# ------------------------------------------------------------------ SMTP 发信（邮箱验证码）
# QQ 邮箱：mail.qq.com → 设置 → 账号与安全 → 开启 IMAP/SMTP 服务 → 生成授权码
# ⚠ 这里填「授权码」而不是 QQ 密码，授权码只显示一次，丢了只能重新生成
# ⚠ HOST / USER / PASSWORD 任一留空 → 发码接口返回 503，注册时无法验证邮箱
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=你的邮箱@qq.com
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MindScope

# ------------------------------------------------------------------ CORS（跨域白名单）
# 默认留空 = 只允许同源（前端与后端同端口时最安全）。
# 只有当前端跑在独立端口/域名时才需要配置，逗号分隔多个来源：
# CORS_ORIGINS=http://localhost:5173,http://192.168.0.10:5173

# ------------------------------------------------------------------ HTTPS / TLS（可选）
# 两个证书路径都配置了才启用 HTTPS，否则保持纯 HTTP。
# 本地自签证书示例：openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#   -keyout key.pem -out cert.pem -subj "/CN=localhost"
# SSL_CERTFILE=cert.pem
# SSL_KEYFILE=key.pem

# ------------------------------------------------------------------ 数据库（线上强烈建议改）
# 默认：backend/depression.db（首次启动从 demo/depression.db 复制，已加入 .gitignore）
# 线上请指到仓库外，否则 git pull/reset 仍可能覆盖数据（BUG-26）
# DATABASE_PATH=/var/lib/mindscope/depression.db
# 启动前自动热备份目录（默认 backend/backups，已加入 .gitignore）
# DB_BACKUP_DIR=/var/lib/mindscope/backups
# 设为 0 可关闭“启动前自动备份”（CI / 本地反复冷启动时）
# DB_BACKUP_ON_START=0
