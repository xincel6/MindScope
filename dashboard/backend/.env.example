# ==============================================================================
#  MindScope 服务端环境变量模板
#
#  用法：
#      copy .env.example .env          （Windows）
#      cp   .env.example .env          （Linux/macOS）
#  然后按需填写下面的值。**不要**把填好的 .env 提交到仓库（已在 .gitignore 排除）。
#
#  优先级：真实环境变量 > .env 里的值 > 本文件中的默认值
#         （启动脚本 .bat 里 `set HOST=0.0.0.0` 的写法依然生效）
# ==============================================================================

# ------------------------------------------------------------------ 服务监听
# 默认仅本机可访问。要让手机 / 其它电脑访问，必须设为 0.0.0.0（或用「启动-局域网共享.bat」）
# HOST=0.0.0.0
# PORT=8000

# ------------------------------------------------------------------ JWT 鉴权
# ⚠ 上线/公开演示前务必改成随机长字符串，否则任何人都能伪造令牌
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-48-byte-string
# 令牌有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------ 视觉大模型 VLM（人脸情绪解读）
# 未配置时：分析与报告功能正常，仅缺少云端语义化解读文本（服务端静默跳过，不报错）
VLM_API_KEY=
VLM_API_HOST=cloud.infini-ai.com
VLM_API_PATH=/maas/v1/chat/completions
VLM_MODEL=glm-4.6v

# ------------------------------------------------------------------ 文本大模型 LLM（报告生成）
# 留空则自动复用上面的 VLM_API_KEY
LLM_API_KEY=
LLM_API_HOST=cloud.infini-ai.com
LLM_API_PATH=/maas/v1/messages
LLM_MODEL=deepseek-v4-flash
